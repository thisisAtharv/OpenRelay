# ==============================================================================
# OpenRelay Demo Client Environment Configuration Example
# Copy this file to .env and supply your OpenRelay API key and recipient details.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Base URL of your OpenRelay backend server
OPENRELAY_URL=http://localhost:4000

# Project-scoped API Key generated from OpenRelay (e.g. or_live_...)
OPENRELAY_API_KEY=or_live_replace_with_your_api_key

# Destination email address for notifications
RECIPIENT_EMAIL=user@example.com

# Optional custom title and message defaults
EMAIL_TITLE=Automated System Alert
EMAIL_MESSAGE=This is a notification dispatched via OpenRelay standalone client.
EMAIL_TYPE=general
