# ==============================================================================
# OpenRelay Production Environment Configuration Example
# Copy this file to .env and replace placeholders with secure, actual values.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Public domain name for Caddy automatic HTTPS (e.g. notify.example.com or localhost)
DOMAIN=notify.example.com

# Public origin for frontend build & backend CORS (e.g. https://notify.example.com)
PUBLIC_ORIGIN=https://notify.example.com

# PostgreSQL Database Configuration
POSTGRES_USER=openrelay_user
POSTGRES_PASSWORD=replace_with_a_secure_random_password
POSTGRES_DB=openrelay_db

# Optional: Prefix for generated API keys (defaults to or_live_)
API_KEY_PREFIX=or_live_

# SMTP / Email Delivery Configuration (Gmail SMTP or any standard SMTP server)
# For Gmail: Use an App Password (not your personal account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=OpenRelay <your_email@gmail.com>
